# Copy to .env and fill in. NEVER commit .env. Zero hardcoded secrets in code.

# --- App ---
APP_ENV=local

# --- PostgreSQL (pgvector + PostgresSaver checkpoints) ---
# App connects as the non-superuser `app_user` (row-level security applies to it).
DATABASE_URL=postgresql://app_user:CHANGE_ME_dev_only@localhost:5432/deal_intel
TEST_DATABASE_URL=postgresql://app_user:CHANGE_ME_dev_only@localhost:5432/deal_intel_test
# Admin role: migrations only (`python -m agents.migrate`).
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deal_intel
TEST_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deal_intel_test
# Set on app_user by the migration runner; must match the password in DATABASE_URL.
APP_USER_PASSWORD=CHANGE_ME_dev_only

# --- Redis / ARQ ---
REDIS_URL=redis://localhost:6379/0

# --- LLM / Observability ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deal-intelligence

# --- CRM OAuth (token vault) ---
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
TOKEN_VAULT_KMS_KEY_ID=

# --- Webhooks ---
WEBHOOK_SIGNING_SECRET=

# --- API ---
JOB_PAYLOAD_MAX_BYTES=65536

# --- Lead research (Spec 005) ---
# "<provider>:<model>" for LangChain init_chat_model; install the matching extra
# (pip install -e '.[llm-anthropic]' or '.[llm-openai]').
LLM_MODEL=
TAVILY_API_KEY=
RESEARCH_MAX_SEARCHES=8
RESEARCH_MAX_LLM_CALLS=8
RESEARCH_MAX_SOURCES=8
RESEARCH_RUN_TIMEOUT_SECONDS=270
JOB_TIMEOUT_SECONDS=300
